datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  MANAGER
  CASHIER
}

model User {
  id            Int            @id @default(autoincrement())
  name          String
  email         String         @unique
  password      String
  role          Role           @default(CASHIER)
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  orders        Order[]
  inventoryLogs InventoryLog[]
  purchases     Purchase[]

  @@map("users")
}

model Category {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  icon     String?
  products Product[]

  @@map("categories")
}

model Product {
  id            Int                 @id @default(autoincrement())
  name          String
  code          String              @unique
  price         Decimal             @db.Decimal(10, 2)
  cost          Decimal             @db.Decimal(10, 2)
  stock         Int                 @default(0)
  minStock      Int                 @default(5) @map("min_stock")
  hasRecipe     Boolean             @default(true) @map("has_recipe")
  image         String?
  categoryId    Int                 @map("category_id")
  category      Category            @relation(fields: [categoryId], references: [id])
  orderItems    OrderItem[]
  ingredients   ProductIngredient[]
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")
  inventoryLogs InventoryLog[]

  @@map("products")
}

model Ingredient {
  id            Int                 @id @default(autoincrement())
  name          String
  code          String              @unique
  unit          String
  stock         Decimal             @default(0.00) @db.Decimal(10, 2)
  minStock      Decimal             @default(5.00) @map("min_stock") @db.Decimal(10, 2)
  cost          Decimal             @default(0.00) @db.Decimal(10, 2)
  productItems  ProductIngredient[]
  purchaseItems PurchaseItem[]
  inventoryLogs InventoryLog[]
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")

  @@map("ingredients")
}

model ProductIngredient {
  id           Int        @id @default(autoincrement())
  productId    Int        @map("product_id")
  ingredientId Int        @map("ingredient_id")
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  quantity     Decimal    @db.Decimal(10, 2)

  @@unique([productId, ingredientId])
  @@map("product_ingredients")
}

model Customer {
  id        Int      @id @default(autoincrement())
  name      String
  phone     String?  @unique
  email     String?
  address   String?
  points    Int      @default(0)
  orders    Order[]
  createdAt DateTime @default(now()) @map("created_at")

  @@map("customers")
}

enum PaymentMethod {
  CASH
  CARD
  QR_CODE
  BANK_TRANSFER
}

enum OrderStatus {
  PENDING
  COMPLETED
  REFUNDED
  CANCELLED
}

model Order {
  id            Int           @id @default(autoincrement())
  orderNumber   String        @unique @map("order_number")
  userId        Int           @map("user_id")
  customerId    Int?          @map("customer_id")
  user          User          @relation(fields: [userId], references: [id])
  customer      Customer?     @relation(fields: [customerId], references: [id])
  items         OrderItem[]
  subtotal      Decimal       @db.Decimal(10, 2)
  discount      Decimal       @default(0) @db.Decimal(10, 2)
  tax           Decimal       @default(0) @db.Decimal(10, 2)
  total         Decimal       @db.Decimal(10, 2)
  paymentMethod PaymentMethod @map("payment_method")
  amountPaid    Decimal       @db.Decimal(10, 2) @map("amount_paid")
  change        Decimal       @db.Decimal(10, 2)
  status        OrderStatus   @default(COMPLETED)
  note          String?
  createdAt     DateTime      @default(now()) @map("created_at")

  @@map("orders")
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int     @map("order_id")
  productId Int     @map("product_id")
  order     Order   @relation(fields: [orderId], references: [id])
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  price     Decimal @db.Decimal(10, 2)
  subtotal  Decimal @db.Decimal(10, 2)

  @@map("order_items")
}

model Supplier {
  id        Int        @id @default(autoincrement())
  name      String
  contact   String?
  phone     String?
  email     String?
  address   String?
  purchases Purchase[]
  createdAt DateTime   @default(now()) @map("created_at")

  @@map("suppliers")
}

model InventoryLog {
  id           Int         @id @default(autoincrement())
  productId    Int?        @map("product_id")
  product      Product?    @relation(fields: [productId], references: [id])
  ingredientId Int?        @map("ingredient_id")
  ingredient   Ingredient? @relation(fields: [ingredientId], references: [id])
  type         String
  quantity     Decimal     @db.Decimal(10, 2)
  beforeQty    Decimal?    @map("before_qty") @db.Decimal(10, 2)
  afterQty     Decimal?    @map("after_qty") @db.Decimal(10, 2)
  note         String?
  userId       Int?        @map("user_id")
  user         User?       @relation(fields: [userId], references: [id])
  createdAt    DateTime    @default(now()) @map("created_at")

  @@map("inventory_logs")
}

model Discount {
  id          Int       @id @default(autoincrement())
  name        String?
  type        String
  value       Decimal   @db.Decimal(10, 2)
  minPurchase Decimal   @db.Decimal(10, 2) @map("min_purchase")
  startDate   DateTime? @db.Date @map("start_date")
  endDate     DateTime? @db.Date @map("end_date")
  isActive    Boolean   @default(true) @map("is_active")

  @@map("discounts")
}

model Purchase {
  id          Int            @id @default(autoincrement())
  reference   String         @unique
  supplierId  Int            @map("supplier_id")
  supplier    Supplier       @relation(fields: [supplierId], references: [id])
  userId      Int            @map("user_id")
  user        User           @relation(fields: [userId], references: [id])
  items       PurchaseItem[]
  totalAmount Decimal        @db.Decimal(10, 2) @map("total_amount")
  note        String?
  createdAt   DateTime       @default(now()) @map("created_at")

  @@map("purchases")
}

model PurchaseItem {
  id           Int        @id @default(autoincrement())
  purchaseId   Int        @map("purchase_id")
  purchase     Purchase   @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  ingredientId Int        @map("ingredient_id")
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])
  quantity     Decimal    @db.Decimal(10, 2)
  cost         Decimal    @db.Decimal(10, 2)
  subtotal     Decimal    @db.Decimal(10, 2)

  @@map("purchase_items")
}

model RolePermission {
  id        Int      @id @default(autoincrement())
  role      Role     @unique
  pages     String[]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("role_permissions")
}

